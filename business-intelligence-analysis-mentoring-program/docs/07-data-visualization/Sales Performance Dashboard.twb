      <aliases enabled='yes' />
      <column caption='Avg Revenue per Rep' datatype='real' name='[Calculation_0369214820519936]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Amount]) / COUNTD([RepID (sales_transactions.csv)])' />
      </column>
      <column caption='Revenue vs Target' datatype='real' name='[Calculation_0369214821683201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Amount]) - SUM([TargetAmount])) / SUM([TargetAmount])' />
      </column>
      <column caption='Deals vs Prev Month' datatype='integer' name='[Calculation_0369214822514690]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Quantity]) - LOOKUP(SUM([Quantity]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Quota Attainment %' datatype='real' name='[Calculation_2652900453134336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Amount]) / SUM([TargetAmount])' />
      </column>
      <column caption='Month-Year' datatype='datetime' name='[Calculation_2652900453224449]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [SaleDate])' />
      </column>
      <column caption='Quarter' datatype='integer' name='[Calculation_2652900453285890]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;quarter&apos;, [SaleDate])' />
      </column>
      <column caption='Performance Flag' datatype='string' name='[Calculation_2652900453371907]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Amount]) &gt;= SUM([TargetAmount]) THEN &quot;On Target&quot; ELSE &quot;Below Target&quot; END' />
      </column>
