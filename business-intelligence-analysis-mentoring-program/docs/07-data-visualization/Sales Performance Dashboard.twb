      <table>
        <view>
          <datasources>
            <datasource caption='Transactions + Targets' name='federated.1td5f5z1gfzuyr195rdh81u4lh9c' />
          </datasources>
          <datasource-dependencies datasource='federated.1td5f5z1gfzuyr195rdh81u4lh9c'>
            <column datatype='real' name='[Amount]' role='measure' type='quantitative' />
            <column caption='Revenue vs Target' datatype='real' name='[Calculation_0369214821683201]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Amount]) - SUM([TargetAmount])) / SUM([TargetAmount])' />
            </column>
            <column caption='Month-Year' datatype='datetime' name='[Calculation_2652900453224449]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [SaleDate])' />
